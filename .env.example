# Configurações da API YouTube Render

# Porta do servidor (padrão: 5000)
PORT=5000

# Modo debug (padrão: False)
DEBUG=False

# Arquivo de cookies do YouTube (padrão: youtube_cookies.txt)
YOUTUBE_COOKIES_FILE=youtube_cookies.txt

# Configurações de cache
CACHE_TYPE=auto  # auto, redis, sqlite, memory
CACHE_TTL=14400  # 4 horas em segundos
CACHE_DB_PATH=cache.db  # Caminho do banco SQLite (se usar sqlite)

# Redis (opcional)
# REDIS_URL=redis://localhost:6379

# Rate limiting
RATE_LIMIT_REQUESTS=10  # Requisições por minuto
TIMEOUT=30  # Timeout em segundos

# Validação
MAX_VIDEO_ID_LENGTH=20
SUPPORTED_DOMAINS=youtube.com,youtu.be
